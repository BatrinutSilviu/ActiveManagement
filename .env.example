# Settings for one copy of the app (one business). Copy to .env next to docker-compose.yml and fill in.
# Left out = Active's values. The business itself (name, kind, currency, colour, parts of the app) is chosen in the
# app at first-run setup and changed in Settings → Business, not here.

# Name of this copy: container, image and Traefik router. Different for every copy on the same server.
APP_NAME=kineto-management
# The domain it's served on (its DNS A record must point at this server).
APP_DOMAIN=app.example.com
# Keeps this copy's database volume apart from other copies' (the volume is <project>_active-data).
COMPOSE_PROJECT_NAME=kineto

# Traefik on this server (see README → "Deploying with Docker + Traefik").
# TRAEFIK_NETWORK=traefik
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt

# Only for the parts of the app that need them (switched on in Settings → Business):
# INTEGRATION_TOKEN=          # events pushed from other apps
# METRICS_HOST_DIR=/var/lib/active-ops/metrics   # server status page: where the ops job writes its snapshots
