{
  "name": "active-management",
  "version": "1.0.0",
  "private": true,
  "description": "Financial & logistics management for the Active community admins",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"node --watch --disable-warning=ExperimentalWarning server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "express": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "vite": "^6.4.5"
  }
}
