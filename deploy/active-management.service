# systemd unit — copy to /etc/systemd/system/active-management.service
[Unit]
Description=Active Management (community admin app)
After=network.target

[Service]
Type=simple
User=active
WorkingDirectory=/opt/active-management
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3001
Environment=DB_PATH=/var/lib/active-management/active.db
Environment=COOKIE_SECURE=true
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server/index.js
Restart=on-failure
RestartSec=3
# hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/active-management
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
